# Carbon platform API — environment configuration. Copy to `.env` and fill in for a
# deployment; every var has a safe local default, so an empty env runs on SQLite.
# NEVER commit a real .env (it is gitignored) — this file documents the keys only.

# --- Database ---
# Omit for local SQLite (sqlite:///./carbon_mvp.db). For production set a Postgres URL;
# a "postgres://" URL is auto-normalised to "postgresql://".
# DATABASE_URL=postgresql://user:password@host:5432/carbon
# Server-DB connection pool (ignored on SQLite):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800

# --- CORS ---
# Comma-separated allowed origins for the browser frontend.
# ALLOWED_ORIGINS=https://app.example.com

# --- Rate limiting (opt-in; unset = disabled) ---
# Per-API-key requests allowed per window before 429. In-process (per worker).
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Server ---
# gunicorn worker count (Dockerfile default 4).
# WEB_CONCURRENCY=4
